{
  "name": "smart-floor",
  "private": true,
  "version": "1.0.0",
  "description": "Offline desktop app for sketching houses in 2D, 3D and first-person walk-through.",
  "license": "MIT",
  "author": "Mohamed El-Bably",
  "type": "module",
  "scripts": {
    "postinstall": "node -e \"require('fs').copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','public/sql-wasm.wasm')\"",
    "dev": "neu run",
    "vite": "vite",
    "build": "node scripts/check-index.mjs && vite build && neu build --release",
    "check": "vue-tsc --noEmit && node scripts/check.mjs",
    "release": "npm run check && npm version -m \"Release v%s\"",
    "version": "node scripts/sync-version.mjs && git add neutralino.config.json",
    "postversion": "git push origin main --follow-tags"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.137",
    "@iconify/vue": "^5.0.3",
    "@neutralinojs/lib": "^6.9.0",
    "@nuxt/ui": "^4.11.2",
    "@vueuse/core": "^14.4.0",
    "jspdf": "^4.2.1",
    "sql.js": "^1.14.2",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@neutralinojs/neu": "^11.7.2",
    "@types/node": "^26.6.3",
    "@types/sql.js": "^1.4.11",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vue-tsc": "^3.3.11"
  }
}
